# Application
ENV_NAME=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# PostgreSQL (local / Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notifications_hub
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/notifications_hub

# API (apps/api — wired by api-bootstrap)
API_HOST=0.0.0.0
API_PORT=8000

# Web (apps/web — wired by web-bootstrap)
NODE_ENV=development
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql
GRAPHQL_ENDPOINT=http://localhost:8000/graphql

# Temporal (local dev — wired by api-bootstrap)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
